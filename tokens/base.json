{
  "$schema": "hud-design-tokens@1",
  "comment": "HUD CONSOLE 设计令牌 —— 唯一事实来源。css/hud.css 的 :root 与 body[data-theme] 映射到 CSS 变量;主题 JS 配置通过 setProperty 覆盖。所有控件、页面、主题只允许引用令牌,禁止硬编码。",

  "color": {
    "bg":       { "value": "#030304",  "css": "--bg",       "role": "画布底色(近黑)" },
    "bg2":      { "value": "#0b0b0d",  "css": "--bg2",      "role": "径向渐变中场" },
    "fg":       { "value": "#e9e9e9",  "css": "--fg",       "role": "主文字/高亮线" },
    "dim":      { "value": "color-mix(in srgb, var(--fg) 45%, transparent)", "css": "--dim",  "role": "次级文字" },
    "faint":    { "value": "color-mix(in srgb, var(--fg) 22%, transparent)", "css": "--faint", "role": "弱提示/小注" },
    "line":     { "value": "color-mix(in srgb, var(--fg) 13%, transparent)", "css": "--line",  "role": "面板边框/分隔线" },
    "accent":   { "value": "#ff9a3c",  "css": "--accent",   "role": "唯一强调色(状态/关键)" },
    "accentRgb":{ "value": "255,154,60", "css": "--accent-rgb", "role": "强调色 RGB 三元组,供 rgba() 使用" },
    "danger":   { "value": "#ff6056",  "css": "--danger",   "role": "语义危险色(仅次于 accent 的第二色,仅错误/删除)" },
    "dangerRgb":{ "value": "255,96,86", "css": "--danger-rgb", "role": "危险色 RGB 三元组" },
    "accentUse":{ "value": 1,          "css": "--accent-use", "role": "0..1,强调色参与 UI 的程度(单色化旋钮)" }
  },

  "line": {
    "width":        { "value": "1px", "css": "--line-w",     "role": "全局线宽:面板边框/分隔线/控件描边,0.5=发丝,2=粗描边仪表感" },
    "bracketWidth": { "value": "1px", "css": "--bracket-w",  "role": "面板四角直角括弧的线宽,可与线宽分离" }
  },

  "scheme": {
    "comment": "深浅双场景。浅色不是深色反色,是独立调色:纸底+墨色+印刷赭石 accent;grain 从 screen 翻成 multiply;WebGL 输出预乘 alpha,混合从加色(ONE,ONE)翻成普通上屏(SRC_ALPHA 系);sparks 发光在浅场景自动关闭。",
    "selector": ":root[data-scheme=\"light\"]",
    "light": {
      "bg": "#f2f1ed", "bg2": "#e6e4de", "fg": "#16161a",
      "accent": "#b35c00", "accentRgb": "179,92,0",
      "danger": "#d43a2f", "dangerRgb": "212,58,47",
      "grainBlend": "multiply", "grainOpacity": 0.08
    },
    "activate": "JS: document.documentElement.dataset.scheme='light'; refreshPalette(); 重放主题以重建 WebGL 点云"
  },

  "spark": {
    "comment": "点缀色火星系统:在全屏上层随机散布、随流场流转的发光微粒。palette 内多色即『橙红随机散布』。",
    "density":   { "value": 110,  "range": [0, 400],  "role": "每 100 万 px² 的微粒数" },
    "ratio":     { "value": 0.14, "range": [0, 1],    "role": "着色微粒占比,其余为白;0=纯单色,0.2-0.4=明显点缀" },
    "palette":   { "value": ["255,154,60"], "role": "着色微粒调色板,多色随机分配即橙红散布" },
    "speed":     { "value": 1,    "range": [0, 4],    "role": "流转速度倍率" },
    "sizeMin":   { "value": 0.8,  "range": [0.4, 3],  "role": "微粒最小直径 px" },
    "sizeMax":   { "value": 2.0,  "range": [0.6, 5],  "role": "微粒最大直径 px" },
    "turbulence":{ "value": 0.0016,"range": [0, 0.01], "role": "流场空间频率,越大轨迹越碎" },
    "glow":      { "value": true, "role": "加色发光(粒子相加)还是普通叠加" },
    "trails":    { "value": true, "role": "着色微粒是否拖尾(彗尾)" },
    "cometEvery":{ "value": 2.4,  "range": [0, 10],   "role": "平均每多少秒诞生一颗亮色彗星(0=关闭)" },
    "opacity":   { "value": 0.6,  "range": [0, 1],    "role": "整体不透明度" }
  },

  "type": {
    "font":      { "value": "Plex, ui-monospace, monospace", "css": "--font", "role": "全局唯一字体栈" },
    "base":      { "value": "10px",   "role": "基础字号" },
    "tracking":  { "value": "0.04em", "role": "正文默认字距" },
    "wide":      { "value": "0.18em", "role": "面板标题字距" },
    "brand":     { "value": "0.32em", "role": "品牌字字距" },
    "scale": {
      "micro":  "7.5px", "small": "8px", "body": "10px",
      "panel": "9.5px",  "kpi":  "17px", "clock": "18px", "board": "26px"
    }
  },

  "space": {
    "gap":   { "value": "10px", "css": "--gap", "role": "网格与列间距,全局唯一节奏" },
    "frame": { "value": "12px 14px", "role": "页面外框留白" },
    "panelBody": { "value": "2px 10px 10px", "role": "面板内容区内边距" },
    "control":   { "value": "6px 10px", "role": "控件默认内边距" }
  },

  "panel": {
    "border":   { "value": "1px solid var(--line)" },
    "bracket":  { "value": "9px", "role": "四角直角括弧尺寸" },
    "tagSize":  { "value": "13px", "role": "字母角标边长" },
    "gradient": { "value": "linear-gradient(180deg, color-mix(in srgb, var(--fg) 2.5%, transparent), color-mix(in srgb, var(--fg) 0.8%, transparent))" }
  },

  "motion": {
    "scrambleMs":    { "value": 420, "role": "数字 settle 时长" },
    "typewriterMs":  { "value": 12,  "role": "日志逐字间隔" },
    "idleOrbit":     { "value": 0.035, "role": "相机闲置自动转速 rad/s" },
    "focusPeriod":   { "value": 14, "role": "3D 焦点推拉周期 s" },
    "scanPeriod":    { "value": 11, "role": "扫描线周期 s" },
    "easing":        { "value": "cubic-bezier(.2,.8,.2,1)" }
  },

  "chrome": {
    "grainOpacity": { "value": 0.055 },
    "scanlineAlpha":{ "value": 0.025 },
    "tickerEveryMs":{ "value": 900 },
    "footerEveryMs":{ "value": 500 },
    "glitchMinS":   { "value": 0.6 },
    "glitchMaxS":   { "value": 3.0 }
  },

  "elevation": {
    "comment": "无阴影层级体系:深度只靠边框/渐变/括弧表达,禁止投影。唯一的 glow 是轨迹辉光(shadowBlur)。"
  }
}
